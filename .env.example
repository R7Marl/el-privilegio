# PostgreSQL connection string. Do not commit your real .env file.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/el_privilegio

# Used only by `npm run db:seed` to create the first administrator.
ADMIN_EMAIL=admin@elprivilegio.local
ADMIN_PASSWORD=change-this-before-seeding

# Long random string used to sign the administrator session cookie.
ADMIN_SESSION_SECRET=replace-with-a-long-random-value
