# Copia este archivo como .env y usa valores únicos, largos y privados.
POSTGRES_DB=el_privilegio
POSTGRES_USER=el_privilegio
POSTGRES_PASSWORD=replace-with-a-unique-database-password

# URL pública final, con HTTPS y sin barra final.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Cuenta inicial del panel. No publiques estos valores.
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=replace-with-a-unique-admin-password

# Cadena aleatoria de al menos 48 caracteres para firmar sesiones.
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret

# En producción con HTTPS deja este valor en true.
ADMIN_COOKIE_SECURE=true
